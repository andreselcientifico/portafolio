                </a>
            </div>
        </div>

         <!-- Tarjeta para Vallenato Femenino -->
        <div class="card bg-base-100 w-full h-full shadow-sm flex flex-col">
            <!-- Imagen representativa de Vallenato Femenino -->
            <Image
                src={vallenatofemenino_img}
                alt="Vallenato Femenino"
                class="w-full h-40 object-cover rounded-t-lg"
            />
            <!-- Cuerpo de la tarjeta con título, descripción y tecnologías utilizadas -->
            <div class="card-body flex flex-col justify-between text-start">
                <h2 class="card-title text-center">Vallenato Femenino</h2>
                <p class="text-gray-400">
                    Vallenato Femenino es una página web dedicada a promover y celebrar el vallenato interpretado por mujeres, con contenido cultural y musical.
                </p>
                <p>
                    Conocimientos: React, Actix Web, Rust
                </p>
