         <!-- Tarjeta para WA Automation -->
        <div class="card bg-base-100 w-full h-full shadow-sm flex flex-col">
            <!-- Imagen representativa de WA Automation -->
            <Image
                src={wa_automation_img}
                alt="WA Automation"
                class="w-full h-40 object-cover rounded-t-lg"
            />
            <!-- Cuerpo de la tarjeta con título, descripción y tecnologías utilizadas -->
            <div class="card-body flex flex-col justify-between text-start">
                <h2 class="card-title text-center">WA Automation</h2>
                <p class="text-gray-400">
                    WA Automation es un proyecto de automatización para WhatsApp, diseñado para facilitar tareas repetitivas y mejorar la eficiencia en comunicaciones.
                </p>
                <p>
                    Conocimientos: Astro, Axum, Rust
                </p>
                <!-- Enlace al repositorio de GitHub -->
                <a
                    href="https://github.com/andreselcientifico/wa-automation"
                    target="_blank"
                    class="text-2xl"
                    aria-label="WA Automation GitHub"
