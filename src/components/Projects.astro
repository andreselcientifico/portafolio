---
import { Image } from "astro:assets";
import pyrumind_img from "@/assets/pyrumind_1.avif";
import polo_img from "@/assets/polo-verduras.avif";
import image_art_img from "@/assets/image-art.avif";
import avis_img from "@/assets/avis.avif";
import nomas_img from "@/assets/nomas.avif";
import interpolador_img from "@/assets/interpolador.avif";
import interpolador1_img from "@/assets/interpolador1.avif";
import interpolador2_img from "@/assets/interpolador2.avif";
import Hiacha_img from "@/assets/Hiacha.avif";
import vallenatofemenino_img from "@/assets/vallenatofemenino.avif";
import wa_automation_img from "@/assets/wa_automation.avif";
import GitHubRepos from "./GitHubRepos.astro";

const props = Astro.props;
---

<!-- Sección de Proyectos: Muestra distintas tarjetas con información sobre cada proyecto -->
<section
    id="projects"
    class="bg-gray-900 text-white min-h-screen p-8 flex flex-col items-center"
>
    <!-- Contenedor de tarjetas en formato grid responsive -->
    <div class="grid grid-cols-1 sm:grid-cols-2 w-full max-w-5xl justify-items-center gap-4">
        
        <!-- Tarjeta del proyecto "Pyrumind" -->
        <div class="card bg-base-100 w-full h-full shadow-sm hover:shadow-lg hover:scale-105 transition-transform duration-300 flex flex-col">
            <!-- Imagen representativa del proyecto -->
            <Image
                src={pyrumind_img}
                alt="Pyrumind"
                class="w-full h-40 object-cover rounded-t-lg"
            />
            <!-- Cuerpo de la tarjeta con título, descripción y tecnologías utilizadas -->
            <div class="card-body flex flex-col justify-between text-start">
                <h2 class="card-title text-center">Pyrumind</h2>
                <p class="text-gray-400">
                    Pyrumind es una plataforma web para crear, leer y traducir libros, facilitando el acceso a una amplia gama de documentos.
                </p>
                <p>
                    Conocimientos: HTML, CSS, JavaScript, Tailwind, Astro, Django
                </p>
                <!-- Botón para ver más detalles -->
                <button class="btn btn-primary" onclick="document.getElementById('modal-pyrumind').showModal()">Ver más</button>
            </div>
        </div>
        
        <!-- Tarjeta del proyecto "Avis" -->
        <div class="card bg-base-100 w-full h-full shadow-sm flex flex-col">
            <!-- Imagen representativa del proyecto -->
            <Image
                src={avis_img}
                alt="Avis"
                class="w-full h-40 object-cover rounded-t-lg"
            />
            <!-- Cuerpo de la tarjeta con título, descripción y tecnologías utilizadas -->
            <div class="card-body flex flex-col justify-between text-start">
                <h2 class="card-title text-center">Avis</h2>
                <p class="text-gray-400">
                    Avis es el sitio web de una pastelería, donde se destacan diseños atractivos y deliciosas propuestas.
                </p>
                <p>
                    Conocimientos: HTML, CSS, JavaScript, Django
                </p>
            </div>
        </div>
        
        <!-- Tarjeta del proyecto "Nomas" -->
        <div class="card bg-base-100 w-full h-full shadow-sm flex flex-col">
            <!-- Imagen representativa del proyecto -->
            <Image
                src={nomas_img}
                alt="Nomas"
                class="w-full h-40 object-cover rounded-t-lg"
            />
            <!-- Cuerpo de la tarjeta con título, descripción y tecnologías utilizadas -->
            <div class="card-body flex flex-col justify-between text-start">
                <h2 class="card-title text-center">Nomas</h2>
                <p class="text-gray-400">
                    Nomas es un portal de noticias que te mantiene informado con contenido actualizado y de calidad.
                </p>
                <p>
                    Conocimientos: HTML, CSS, JavaScript, Astro, Tailwind
                </p>
            </div>
        </div>
        
        <!-- Tarjeta del proyecto "Interpolador de Frame" -->
        <div class="card bg-base-100 w-full h-full shadow-sm flex flex-col">
            <!-- Carrusel de imágenes para mostrar diferentes vistas del proyecto -->
            <div class="carousel w-full h-40 rounded-t-lg overflow-hidden">
                <div id="item1" class="carousel-item w-full">
                    <Image
                        src={interpolador_img}
                        alt="Interpolador de Frame - vista 1"
                        class="w-full h-40 object-cover"
                    />
                </div>
                <div id="item2" class="carousel-item w-full">
                    <Image
                        src={interpolador1_img}
                        alt="Interpolador de Frame - vista 2"
                        class="w-full h-40 object-cover"
                    />
                </div>
                <div id="item3" class="carousel-item w-full">
                    <Image
                        src={interpolador2_img}
                        alt="Interpolador de Frame - vista 3"
                        class="w-full h-40 object-cover"
                    />
                </div>
            </div>
            <!-- Cuerpo de la tarjeta con controles del carrusel, título, descripción y tecnologías utilizadas -->
            <div class="card-body flex flex-col justify-between text-start">
                <!-- Controles para navegar entre las imágenes del carrusel -->
                <div class="flex w-full justify-center gap-2">
                    <a href="#item1" class="btn btn-xs">1</a>
                    <a href="#item2" class="btn btn-xs">2</a>
                    <a href="#item3" class="btn btn-xs">3</a>
                </div>
                <h2 class="card-title text-center">Interpolador de Frame</h2>
                <p class="text-gray-400">
                    Interpolador de Frame es un proyecto personal diseñado para optimizar la fluidez en la captura de video, mejorando la transición entre fotogramas.
                </p>
                <p>
                    Conocimientos: Python, OpenCV
                </p>
            </div>
        </div>
        
        <!-- Tarjeta para jhon polo verduras -->
        <div class="card bg-base-100 w-full h-full shadow-sm flex flex-col">
            <!-- Imagen representativa que indica la pagina -->
            <Image
                src={polo_img}
                alt="Proyectos en construcción"
                class="w-full h-40 object-cover rounded-t-lg"
            />
            <!-- Cuerpo de la tarjeta con título, descripción y enlace al perfil de GitHub -->
            <div class="card-body flex flex-col justify-between text-start">
                <h2 class="card-title text-center">
                    Jhon polo verduras
                </h2>
                <p class="text-gray-400">
                    Jhon polo verduras es una pagina web que contiene informacion sobre el mercado local de verduras.
                </p>
                <!-- Enlace al pagina polo -->
                <a
                    href="https://jhon-polo.pages.dev/"
                    target="_blank"
                    class="text-2xl"
                    aria-label="pagina jhon polo"
                >
                    <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 48 48">
                        <image href="data:image/png;base64," height="48" width="48"/>
                    </svg>
                </a>
            </div>
        </div>

         <!-- Tarjeta para hiacha -->
        <div class="card bg-base-100 w-full h-full shadow-sm flex flex-col">
            <!-- Imagen representativa hiacha-->
            <Image
                src={Hiacha_img}
                alt="Proyectos en construcción"
                class="w-full h-40 object-cover rounded-t-lg"
            />
            <!-- Cuerpo de la tarjeta con título, descripción y enlace a hiacha -->
            <div class="card-body flex flex-col justify-between text-start">
                <h2 class="card-title text-center">
                    HIACHA
                </h2>
                <p class="text-gray-400">
                    HIACHA es una plataforma de alimentos, comidas rapidas y saludables, diseñada para ofrecer opciones nutritivas y deliciosas.
                </p>
                <!-- Enlace al perfil de GitHub -->
                <a
                    href="https://hiacha-conecta-sabor.pages.dev/"
                    target="_blank"
                    class="text-2xl"
                    aria-label="HIACHA"
                >
                    <svg width="24px" height="24px" viewBox="0 0 24.00 24.00" fill="none" xmlns="http://www.w3.org/2000/svg" stroke="#04ff00" transform="matrix(1, 0, 0, 1, 0, 0)"><g id="SVGRepo_bgCarrier" stroke-width="0"></g><g id="SVGRepo_tracerCarrier" stroke-linecap="round" stroke-linejoin="round"></g><g id="SVGRepo_iconCarrier"> <path opacity="0.5" d="M12 22C7.28595 22 4.92893 22 3.46447 20.5355C2 19.0711 2 16.714 2 12C2 7.28595 2 4.92893 3.46447 3.46447C4.92893 2 7.28595 2 12 2C16.714 2 19.0711 2 20.5355 3.46447C22 4.92893 22 7.28595 22 12C22 16.714 22 19.0711 20.5355 20.5355C19.0711 22 16.714 22 12 22Z" fill="#1C274C"></path> <path d="M9.198 7.25H9.30203H9.30206C10.2005 7.24997 10.9497 7.24995 11.5445 7.32991C12.1723 7.41432 12.7391 7.59999 13.1945 8.05546C13.65 8.51093 13.8357 9.07773 13.9201 9.70552C14.0001 10.3003 14 11.0495 14 11.948L14 12C14 12.4142 13.6642 12.75 13.25 12.75C12.8358 12.75 12.5 12.4142 12.5 12C12.5 11.036 12.4984 10.3884 12.4335 9.9054C12.3714 9.44393 12.2642 9.24644 12.1339 9.11612C12.0036 8.9858 11.8061 8.87858 11.3446 8.81654C10.8616 8.7516 10.214 8.75 9.25 8.75C8.28599 8.75 7.63843 8.7516 7.1554 8.81654C6.69393 8.87858 6.49644 8.9858 6.36612 9.11612C6.2358 9.24644 6.12858 9.44393 6.06654 9.9054C6.0016 10.3884 6 11.036 6 12C6 12.964 6.0016 13.6116 6.06654 14.0946C6.12858 14.5561 6.2358 14.7536 6.36612 14.8839C6.49644 15.0142 6.69393 15.1214 7.1554 15.1835C7.63843 15.2484 8.28599 15.25 9.25 15.25C9.66422 15.25 10 15.5858 10 16C10 16.4142 9.66422 16.75 9.25 16.75L9.19798 16.75C8.29951 16.75 7.5503 16.7501 6.95552 16.6701C6.32773 16.5857 5.76093 16.4 5.30546 15.9445C4.84999 15.4891 4.66432 14.9223 4.57991 14.2945C4.49995 13.6997 4.49997 12.9505 4.5 12.052V12.052V11.948V11.9479C4.49997 11.0495 4.49995 10.3003 4.57991 9.70552C4.66432 9.07773 4.84999 8.51093 5.30546 8.05546C5.76093 7.59999 6.32773 7.41432 6.95552 7.32991C7.55029 7.24995 8.29953 7.24997 9.19798 7.25H9.198Z" fill="#1C274C"></path> <path d="M16.8446 8.81654C16.3616 8.7516 15.71