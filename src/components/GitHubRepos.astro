---
// Componente para mostrar repositorios de GitHub
---

<div class="mt-8">
    <h2 class="text-2xl font-bold text-center mb-4">Mis Repositorios en GitHub</h2>
    <div id="github-repos" class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-4">
        <!-- Los repos se cargarán aquí -->
    </div>
</div>

<script>
    async function loadRepos() {
        try {
            const response = await fetch('https://api.github.com/users/andreselcientifico/repos?sort=updated&per_page=10');
            const repos = await response.json();
            const publicRepos = repos.filter(repo => !repo.private);
            const container = document.getElementById('github-repos');
            container.innerHTML = publicRepos.slice(0, 6).map(repo => `
                <div class="card bg-base-100 shadow-sm">
                    <div class="card-body">
                        <h3 class="card-title">${repo.name}</h3>
                        <p class="text-gray-400">${repo.description || 'Sin descripción'}</p>
                        <p>Lenguaje: ${repo.language || 'N/A'}</p>
                        <a href="${repo.html_url}" target="_blank" class="btn btn-sm">Ver en GitHub</a>
                    </div>
                </div>
            `).join('');
        } catch (error) {
            console.error('Error cargando repos:', error);
        }
    }
    loadRepos();
</script>